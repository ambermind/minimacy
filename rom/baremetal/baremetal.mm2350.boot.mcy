//	else if timeMs-LastLeft<20 then echo "-";
//	if !gpioGet (SWITCH_RIGHT) then (set LastRight=timeMs; echo "R")
//	else if timeMs-LastRight<20 then echo "-";
//	onTimeout (1, #gpioLoop);;

fun main()=
	gpioPut(true, gpioSetDir(true, gpioInit(SD_CS_PIN)));
	gpioPut(true, gpioSetDir(true, gpioInit(SPI_CS_LEFT_PIN)));
	gpioPut(true, gpioSetDir(true, gpioInit(SPI_CS_RIGHT_PIN)));

	ssd1306SetLock(CommonI2c0Lock);
	mcp7940nSetLock(CommonI2c0Lock);
	encX24j600SetLock(CommonSpi0Lock);
	sdSetLock(CommonSpi0Lock);

	set RTC=mcp7940nInit(I2C_PORT, I2C_SDA_PIN, I2C_SCL_PIN);
	if time()>1000 then mcp7940nSetTime(RTC, time());	// t is 0 at startup when not provided by bootloader
	let mcp7940nTime(RTC) -> t in (
		echoLn strFormat("> RTC: *", fullDate(t));
		timeSet(t)
	);
	set _Oled=ssd1306Init(I2C_PORT, I2C_SDA_PIN, I2C_SCL_PIN);
	splashDisplay(SPLASH);

	gpioSetPulls(true, false, gpioSetDir(false, gpioInit(SWITCH_LEFT)));
	gpioSetPulls(true, false, gpioSetDir(false, gpioInit(SWITCH_RIGHT)));

	keyEmulateWithGpio(Key_Left, SWITCH_LEFT);
	keyEmulateWithGpio(Key_Right, SWITCH_RIGHT);
	displaySetup(128, 64, (lambda(bmp)=ssd1306Blit(oled(), bmp, 0); true));

	set _EthLeft = encX24j600Init(ETH_LEFT,  SPI_PORT, SPI_CLK_PIN, SPI_MOSI_PIN, SPI_MISO_PIN, SPI_CS_LEFT_PIN,  SPI_INT_LEFT_PIN);
	set _EthRight= encX24j600Init(ETH_RIGHT, SPI_PORT, SPI_CLK_PIN, SPI_MOSI_PIN, SPI_MISO_PIN, SPI_CS_RIGHT_PIN, SPI_INT_RIGHT_PIN);

	//if true then void gpioLoop()
	//else
	if !gpioGet(SWITCH_RIGHT) then (
		start("demo.fun.wall")
	)
	else let !gpioGet(SWITCH_LEFT) -> biosMode in
	if biosMode then (
		_disksInit(biosMode);
		start("baremetal.mm2350.admin")
	)
	else (
		_disksInit(biosMode);
		start("boot");
	);;
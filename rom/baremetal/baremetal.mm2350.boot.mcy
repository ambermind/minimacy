const CommonI2c0Lock=lockCreate();;
const CommonSpi0Lock=lockCreate();;
const CommonI2c1Lock=lockCreate();;
const CommonSpi1Lock=lockCreate();;
const ETH_LEFT="left";;
const ETH_RIGHT="right";;

var RTC;;
var SdCard;;
var _FlashVolume;;

var _EthLeft;;
var _EthRight;;
var _Oled;;

fun oled()=_Oled;;
fun ethLeft()=_EthLeft;;
fun ethRight()=_EthRight;;

extend VolumeType with flashVolume;;

const FLASHDISK_START = 2*1024*1024;;	// we keep 2MB for the Minimacy firmware
const FLASHDISK_WRITE_LEN = 4096/512;;	// nb of sectors per flash writing block

fun flashMemRead(start, nb)= flashRead(FLASHDISK_START+start*512, nb*512);;

fun _flashMemWrite(sector, data, offset, nbSectors) =
	if nbSectors>0 then
	let sector%FLASHDISK_WRITE_LEN -> sectorOffset in
	let sector/FLASHDISK_WRITE_LEN -> flashCluster in
	if sectorOffset==0 && nbSectors>=FLASHDISK_WRITE_LEN then
		let bytesSlice(data, offset, 4096) -> bytes in (
			flashWrite(bytes, FLASHDISK_START+flashCluster*4096);
			set bytes=nil;	// allow gc on this
			4096+_flashMemWrite(sector+8, data, offset+4096, nbSectors-8)
		)
	else
	let flashRead(FLASHDISK_START+ flashCluster*4096, 4096) -> bytes in (
		bytesCopyBytes(bytes, sectorOffset*512, data, offset, 512);
		flashWrite(bytes, FLASHDISK_START+ flashCluster*4096);
		set bytes=nil;	// allow gc on this
		512+_flashMemWrite(sector+1, data, offset+512, nbSectors-1)
	);;

fun flashMemWrite(sector, data)= 
	let bytesLength(data)>>9 -> nbSectors in
	if (nbSectors>=1) && !bitTest(bytesLength(data), 511) then
	_flashMemWrite(sector, data, 0, nbSectors);;

fun flashFormat ()=
	volumeFormatFat32(_FlashVolume, (flashSize() - FLASHDISK_START)/512, 8, "FLASH", true);;

fun _sdRead(sector, nbSectors) = sdRead(SdCard, sector, nbSectors);;
fun _sdWrite(sector, data) = sdWrite(SdCard, sector, data);;

fun _disksInit(biosMode) =
	volumeSetCacheSize(1024*64);
	let set _FlashVolume= volumeCreate(flashVolume, nil, true, #flashMemRead, #flashMemWrite, (flashSize() - FLASHDISK_START)/512, 512) -> volume in
	let volumeMount(volume, if biosMode then "flash/" else "", "/") -> mounts in
	if !biosMode then
		for m in mounts do romdiskFromMountSources(mountIndex(m), 2);

	hide flashRead flashWrite flashMemRead flashMemWrite;	// prevent programs from addressing flash directly

	set SdCard=sdInit(SPI_PORT, SPI_CLK_PIN, SPI_MOSI_PIN, SPI_MISO_PIN, SD_CS_PIN);
	if SdCard<>nil then
	let volumeCreate(sdVolume, nil, true, #_sdRead, #_sdWrite, sdNbSectors(SdCard), sdSectorSize(SdCard))-> volume in
//		let volumeFormatFat32 (volume, sdNbSectors (SdCard), 32, "SD32", true) -> _ in
		let volumeMount(volume, if biosMode then "sd/" else "", "/") -> mounts in
		if !biosMode then
			for m in mounts do romdiskFromMountSources(mountIndex(m), 2);
	true;;

fun splashDisplay(splash)=
	ssd1306BlitRaw(oled(), splash);;


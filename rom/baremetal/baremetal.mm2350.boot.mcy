const SPI_CLK_PIN = 2;;
const SPI_MOSI_PIN= 3;;
const SPI_MISO_PIN= 4;;

const SD_CS_PIN  = 5;;
const SPI_CS_LEFT_PIN  = 7;;
const SPI_CS_RIGHT_PIN = 6;;
const SPI_INT_LEFT_PIN = 23;;
const SPI_INT_RIGHT_PIN= 22;;

const I2C_PORT    = I2c0;;
const I2C_SDA_PIN = 16;;
const I2C_SCL_PIN = 17;;

const SWITCH_LEFT = 20;;
const SWITCH_RIGHT= 18;;

const EXT_SPI_PORT    =Spi1;;
const EXT_SPI_CLK_PIN = 10;;
const EXT_SPI_MOSI_PIN= 11;;
const EXT_SPI_MISO_PIN= 12;;
const EXT_SPI_CS_PIN  = 13;;

const EXT_I2C_PORT   = I2c1;;
const EXT_I2C_SDA_PIN= 14;;
const EXT_I2C_SCL_PIN= 15;;

const EXT_GPIO_26_PIN= 26;;
const EXT_GPIO_27_PIN= 27;;
const EXT_GPIO_28_PIN= 28;;
const EXT_GPIO_29_PIN= 29;;


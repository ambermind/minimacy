// based on "BCM2711 ARM Peripherals" documentation, chapter 9 'SPI', and chapter 5.3 'Alternative Function Assignments'

export Spi0, Spi3, Spi4, Spi5, Spi6;;
export spiSetBaudrate(spi, baudrate);;
export spiInit(spi, baudrate, clk_pin, mosi_pin, miso_pin);;
export spiWriteByte(spi, dataInt);;
export spiWrite(spi, dataStr);;
export spiWriteRead(spi, dataStr);;
export spiRead(spi, dataInt, len);;
export spiWriteBytes(spi, dataBytes);;
export spiWriteReadBytes(spi, dataBytes);;
export spiReadBytes(spi, dataInt, len);;

use driver.rpi4.gpio;;

const CLOCK_ID_CORE=4;;
const SPI_BASE= 0xFE204000;;
const Spi0 = SPI_BASE+0x000;;
const Spi3 = SPI_BASE+0x600;;
const Spi4 = SPI_BASE+0x800;;
const Spi5 = SPI_BASE+0xa00;;
const Spi6 = SPI_BASE+0xc00;;

const SPI_CS  = 0x00;;
	const CS_CLEAR_TX=0x10;;
	const CS_CLEAR_RX=0x20;;
	const CS_TA      =0x80;;
	const CS_DONE    =0x10000;;
	const CS_RXD     =0x20000;;
	const CS_TXD     =0x40000;;
const SPI_FIFO= 0x04;;
const SPI_CLK = 0x08;;
const SPI_DLEN= 0x0c;;

fun spiAltFunc(spi, clk_pin, mosi_pin, miso_pin) =
// nothing smart here, see 'Table 94. GPIO Pins Alternative Function Assignment'
	if mosi_pin == clk_pin-1 && (miso_pin==nil || miso_pin==clk_pin-2) then
	match spi with
		Spi0 -> if clk_pin == 11 || clk_pin == 39 then FSEL_ALT0
			else if clk_pin==42 then FSEL_ALT4,
		Spi3 -> if clk_pin == 3 then FSEL_ALT3,
		Spi4 -> if clk_pin == 7 then FSEL_ALT3,
		Spi5 -> if clk_pin == 15 then FSEL_ALT3,
		Spi6 -> if clk_pin == 21 then FSEL_ALT3;;

fun spiSetBaudrate(spi, baudrate)=
	let clockRate(CLOCK_ID_CORE) -> rate in
	let rate/baudrate -> divider in
	write32(spi+SPI_CLK, divider);;

fun spiInit(spi, baudrate, clk_pin, mosi_pin, miso_pin)=
	let spiAltFunc(spi, clk_pin, mosi_pin, miso_pin) -> fsel_alt in
	if fsel_alt<>nil then (
		gpioSetPulls(true, false, gpioSetAlt(fsel_alt, clk_pin));
		gpioSetPulls(true, false, gpioSetAlt(fsel_alt, mosi_pin));
		if miso_pin<>nil then gpioSetPulls(true, false, gpioSetAlt(fsel_alt, miso_pin));
		spiSetBaudrate(spi, baudrate);
		spi
	);;

fun spiCommon(spi, dataStr, dataBytes, dataInt, len, read)=
	let len +strLength(dataStr)+bytesLength(dataBytes) -> len in
	let if read then bytesCreate(len, 0) -> bytes in
	let 0 -> iRead in
	let 0 -> iWrite in (
		write32(spi+SPI_DLEN, len);
		write32(spi+SPI_CS, read32(spi+SPI_CS)| CS_CLEAR_RX | CS_CLEAR_TX | CS_TA);
		while (iRead<len) || (iWrite<len) do (
			while (iWrite<len) && bitTest(read32(spi+SPI_CS), CS_TXD) do (
				write32(spi+SPI_FIFO,
					if dataStr<>nil then strGet(dataStr, iWrite)
					else if dataBytes<>nil then bytesGet(dataBytes, iWrite)
					else dataInt
				);
				set iWrite=iWrite+1
			);
			while (iRead<len) && bitTest(read32(spi+SPI_CS), CS_RXD) do (
				bytesSet(bytes, iRead, read32(spi+SPI_FIFO));
				set iRead=iRead+1
			);
		);
	    while !bitTest(read32(spi+SPI_CS), CS_DONE) do
			while bitTest(read32(spi+SPI_CS), CS_RXD) do
				read32(spi+SPI_FIFO);
		write32(spi+SPI_CS, read32(spi+SPI_CS)&~CS_TA);
		bytes
	);;

fun spiWriteByte(spi, dataInt)= bytesGet(spiCommon(spi, nil, nil, dataInt, 1, true), 0);;
fun spiWrite(spi, dataStr)= spiCommon(spi, dataStr, nil, nil, nil, false); strLength(dataStr);;
fun spiWriteRead(spi, dataStr)= strFromBytes(spiCommon(spi, dataStr, nil, nil, nil, true));;
fun spiRead(spi, dataInt, len)= strFromBytes(spiCommon(spi, nil, nil, dataInt, len, true));;

fun spiWriteBytes(spi, dataBytes)= spiCommon(spi, nil, dataBytes, nil, nil, false); bytesLength(dataBytes);;
fun spiWriteReadBytes(spi, dataBytes)= strFromBytes(spiCommon(spi, nil, dataBytes, nil, nil, true));;
fun spiReadBytes(spi, dataInt, len)= spiCommon(spi, nil, nil, dataInt, len, true);;

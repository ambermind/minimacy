const PCIE_BASE= 0xFD500000;;

const PCI_COMMAND        = PCIE_BASE+0x04;;
	const COMMAND_MEMORY    = 0x02;;
	const COMMAND_MASTER    = 0x04;;
	const COMMAND_PARITY    = 0x40;;
	const COMMAND_SERR      = 0x100;;
const PCI_CACHE_LINE_SIZE= PCIE_BASE+0x0C;;
const PCI_BASE_ADDRESS_0    = 0x10;;
const PCI_BASE_ADDRESS_1    = 0x14;;
	const BASE_ADDRESS_MEM_TYPE_64= 0x04;;
const PCI_SECONDARY_BUS  = PCIE_BASE+0x19;;
const PCI_SUBORDINATE_BUS= PCIE_BASE+0x1A;;
const PCI_MEMORY_BASE    = PCIE_BASE+0x20;;
const PCI_MEMORY_LIMIT   = PCIE_BASE+0x22;;
const PCI_BRIDGE_CONTROL = PCIE_BASE+0x3E;;
	const BRIDGE_CTL_PARITY	= 0x01;;

const PCIE_EXP_LNKCAP    = PCIE_BASE+0x00B8;;
	const EXP_LNKCAP_SLS    = 0x0F;;
	const EXP_GEN           = 0x02;;
const PCIE_EXP_RTCTL     = PCIE_BASE+0x00C8;;
const PCIE_EXP_LNKCTL2   = PCIE_BASE+0x00DC;;
	const EXP_RTCTL_CRSSVE  = 0x0010;;
const PCIE_RC_CFG_VS_REG1= PCIE_BASE+0x0188;;
	const REG1_ENDIAN_MODE_BAR2_MASK = 0x0C;;
const PCIE_RC_CFG_ID_VAL3= PCIE_BASE+0x043C;;
	const ID_VAL3_CLASS_CODE_MASK            = 0xFFFFFF;;
	const ID_VAL3_CLASS_CODE_PCIE_PCIE_BRIDGE= 0x060400;;
const PCIE_CTRL          = PCIE_BASE+0x4008;;
	const CTRL_SCB_ACCESS_EN   = 0x1000;;
	const CTRL_CFG_READ_UR_MODE= 0x2000;;
	const CTRL_SCB0_SIZE_MASK  = 0xF8000000;;
	const CTRL_SCB0_SIZE_SHIFT = 27;;
const PCIE_CPU_2_MEM_WIN0= PCIE_BASE+0x400C;;
const PCIE_RC_BAR1_CONFIG= PCIE_BASE+0x402C;;
	const RC_BAR1_CONFIG_LO_SIZE_MASK = 0x1F;;
const PCIE_RC_BAR2_CONFIG= PCIE_BASE+0x4034;;
const PCIE_RC_BAR3_CONFIG= PCIE_BASE+0x403C;;
	const RC_BAR3_CONFIG_LO_SIZE_MASK = 0x1F;;
const PCIE_CPU_2_MEM_WIN0_BASE   = PCIE_BASE+0x4070;;
	const WIN0_BASE_MASK            = 0xFFF0;;
	const WIN0_BASE_SHIFT           = 4;;
const PCIE_CPU_2_MEM_WIN0_LIMIT  = PCIE_BASE+0x4072;;
	const WIN0_LIMIT_MASK           = 0xFFF0;;
	const WIN0_LIMIT_SHIFT          = 4;;
const PCIE_CPU_2_MEM_WIN0_BASE_HI= PCIE_BASE+0x4080;;
	const WIN0_BASE_HI_MASK         = 0xFF;;
	const WIN0_BASE_HI_SHIFT        = 12;;
const PCIE_CPU_2_MEM_WIN0_LIMIT_HI= PCIE_BASE+0x4084;;
	const WIN0_LIMIT_HI_MASK         = 0xFF;;
	const WIN0_LIMIT_HI_SHIFT        = 12;;
const PCIE_HARD          = PCIE_BASE+0x4204;;
	const HARD_CLKREQ_DEBUG_ENABLE= 0x02;;
	const HARD_SERDES_IDDQ        = 0x08000000;;
const PCIE_INTR2_CPU_BASE_CLR= PCIE_BASE+0x4308;;
const PCIE_INTR2_CPU_BASE_SET= PCIE_BASE+0x4310;;
const PCIE_EXT_CFG_DATA  = PCIE_BASE+0x8000;;
const PCIE_EXT_CFG_INDEX = PCIE_BASE+0x9000;;
const PCIE_RGR1_SW_INIT_1= PCIE_BASE+0x9210;;
	const RGR1_SW_INIT_1_PERST= 0x01;;
	const RGR1_SW_INIT_1_INIT = 0x02;;

const MEM_PCIE_PCIE_BASE= 0xF8000000;;
const MEM_PCIE_CPU_BASE = 0x6000;;	// already divided by 4096
const MEM_PCIE_CPU_LIMIT= 0x603F;;	// already divided by 4096

const MEM_DMA_PCIE_BASE_HI= 0x4;;
const MEM_DMA_SIZE        = 0xC0000000;;
const MEM_DMA_SIZE_ENCODED= 16;;

fun clr32(addr, mask) = write32(addr, read32(addr)&(~mask));;
fun set32(addr, mask) = write32(addr, read32(addr)|mask);;

fun clr16(addr, mask) = write16(addr, read16(addr)&(~mask));;
fun set16(addr, mask) = write16(addr, read16(addr)|mask);;

fun pcieInit()=
	set32(PCIE_RGR1_SW_INIT_1, RGR1_SW_INIT_1_INIT);
	set32(PCIE_RGR1_SW_INIT_1, RGR1_SW_INIT_1_PERST);

	sleepMs(1); 
	clr32(PCIE_RGR1_SW_INIT_1, RGR1_SW_INIT_1_INIT);
	clr32(PCIE_HARD, HARD_SERDES_IDDQ);
	sleepMs(1); 

	write32(PCIE_CTRL,CTRL_SCB_ACCESS_EN |CTRL_CFG_READ_UR_MODE);

	write32(PCIE_RC_BAR2_CONFIG, MEM_DMA_SIZE_ENCODED);
	write32(PCIE_RC_BAR2_CONFIG+4, MEM_DMA_PCIE_BASE_HI);

	clr32(PCIE_CTRL, CTRL_SCB0_SIZE_MASK);
	set32(PCIE_CTRL, MEM_DMA_SIZE_ENCODED<<CTRL_SCB0_SIZE_SHIFT);

	clr32(PCIE_RC_BAR1_CONFIG, RC_BAR1_CONFIG_LO_SIZE_MASK);
	clr32(PCIE_RC_BAR3_CONFIG, RC_BAR3_CONFIG_LO_SIZE_MASK);

	write32(PCIE_INTR2_CPU_BASE_CLR, 0xFFFFFFFF);
	write32(PCIE_INTR2_CPU_BASE_SET, 0xFFFFFFFF);

	clr32(PCIE_EXP_LNKCAP, EXP_LNKCAP_SLS);
	set32(PCIE_EXP_LNKCAP, EXP_GEN);
	clr16(PCIE_EXP_LNKCTL2, EXP_LNKCAP_SLS);
	set16(PCIE_EXP_LNKCTL2, EXP_GEN);

	clr32(PCIE_RGR1_SW_INIT_1, RGR1_SW_INIT_1_PERST);
	sleepMs(100);

	write32(PCIE_CPU_2_MEM_WIN0, MEM_PCIE_PCIE_BASE);
	write32(PCIE_CPU_2_MEM_WIN0+4, 0);

	clr16(PCIE_CPU_2_MEM_WIN0_BASE, WIN0_BASE_MASK);
	set16(PCIE_CPU_2_MEM_WIN0_BASE, MEM_PCIE_CPU_BASE<< WIN0_BASE_SHIFT);

	clr32(PCIE_CPU_2_MEM_WIN0_BASE_HI, WIN0_BASE_HI_MASK);
	set32(PCIE_CPU_2_MEM_WIN0_BASE_HI, MEM_PCIE_CPU_BASE >> WIN0_BASE_HI_SHIFT);

	clr16(PCIE_CPU_2_MEM_WIN0_LIMIT, WIN0_LIMIT_MASK);
	set16(PCIE_CPU_2_MEM_WIN0_LIMIT, MEM_PCIE_CPU_LIMIT<< WIN0_LIMIT_SHIFT);
	
	clr32(PCIE_CPU_2_MEM_WIN0_LIMIT_HI, WIN0_LIMIT_HI_MASK);
	set32(PCIE_CPU_2_MEM_WIN0_LIMIT_HI, MEM_PCIE_CPU_LIMIT >> WIN0_LIMIT_HI_SHIFT);

	clr32(PCIE_RC_CFG_ID_VAL3, ID_VAL3_CLASS_CODE_MASK);
	set32(PCIE_RC_CFG_ID_VAL3, ID_VAL3_CLASS_CODE_PCIE_PCIE_BRIDGE);
	clr32(PCIE_RC_CFG_VS_REG1, REG1_ENDIAN_MODE_BAR2_MASK);
	set32(PCIE_HARD, HARD_CLKREQ_DEBUG_ENABLE);

	write8 (PCI_CACHE_LINE_SIZE, 16);
	write8 (PCI_SECONDARY_BUS, 1);
	write8 (PCI_SUBORDINATE_BUS, 1);
	write16(PCI_MEMORY_BASE, MEM_PCIE_PCIE_BASE >> 16);
	write16(PCI_MEMORY_LIMIT, MEM_PCIE_PCIE_BASE >> 16);
	write8 (PCI_BRIDGE_CONTROL, BRIDGE_CTL_PARITY);
	write8 (PCIE_EXP_RTCTL, EXP_RTCTL_CRSSVE);
	write16(PCI_COMMAND, COMMAND_MEMORY| COMMAND_MASTER| COMMAND_PARITY| COMMAND_SERR);
	true;;

fun pcieEnable()=
	write32(PCIE_EXT_CFG_INDEX, 0x100000);
	write8 (PCIE_EXT_CFG_DATA + PCI_CACHE_LINE_SIZE, 16);
	write32(PCIE_EXT_CFG_DATA + PCI_BASE_ADDRESS_0, MEM_PCIE_PCIE_BASE|BASE_ADDRESS_MEM_TYPE_64);
	write32(PCIE_EXT_CFG_DATA + PCI_BASE_ADDRESS_1, 0);
	write16(PCIE_EXT_CFG_DATA + PCI_COMMAND, COMMAND_MEMORY| COMMAND_MASTER| COMMAND_PARITY| COMMAND_SERR);
	true;;

Key_Page_Down,	'3',	nil,	nil,	//0x5B
Key_Left,	'4',	nil,	nil,	//0x5C
nil,	'5',	nil,	nil,	//0x5D
Key_Right,	'6',	nil,	nil,	//0x5E
Key_Home,	'7',	nil,	nil,	//0x5F

};;

const Hid_KeyMask_Controls_Mask= 0x11;;
const Hid_KeyMask_Shifts_Mask  = 0x22;;
const Hid_KeyMask_Metas_Mask   = 0x88;;
const Hid_KeyMask_Alt_Mask     = 0x04;;
const Hid_KeyMask_AltGr_Mask   = 0x40;;

const KEYBOARD_REPORT_SIZE=8;;

//Minimacy constants:
// KeyMask_Shift  =1
// KeyMask_Alt    =2
// KeyMask_Control=4
// KeyMask_Meta   =8

struct Keyboard=[stateK, vectorK, modifierK];;
fun _keyboardCode(kb, key)=
	let (if bitTest(kb.modifierK, Hid_KeyMask_Shifts_Mask) then 1)|(if bitTest(kb.modifierK, Hid_KeyMask_AltGr_Mask) then 2) -> offset in
	KeyCodes[key<<2 + offset];;

fun _keyboardRepeat(kb, i, code, delay) =
	let _keyboardCode(kb, code) -> key in
	if key<>nil then (
		if DEBUG then echoLn strFormat("keyDown *", key);
		uiPostKeyDown(key)
	);
	onTimeout(delay, lambda ()=
		if strGet(kb.vectorK, i)==code then _keyboardRepeat(kb, i, code, 100)
	);;
fun _keyboardLoop(ep, kb)=
	interruptTransfer(ep, KEYBOARD_REPORT_SIZE, lambda(data)=
		if !strEmpty(data) then (
			if DEBUG then echoLn "Keyboard Interrupt";
			if DEBUG then hexDump data;
			set kb.modifierK=strGet(data, 0);
			set kb.stateK=	// for minimacy keyboardState function
				(if bitTest(kb.modifierK, Hid_KeyMask_Shifts_Mask  ) then KeyMask_Shift)|
				(if bitTest(kb.modifierK, Hid_KeyMask_Controls_Mask) then KeyMask_Control)|
				(if bitTest(kb.modifierK, Hid_KeyMask_Alt_Mask     ) then KeyMask_Alt)|
				(if bitTest(kb.modifierK, Hid_KeyMask_Metas_Mask   ) then KeyMask_Meta);

			for i=2;i<KEYBOARD_REPORT_SIZE do
				let strGet(data, i) -> now in
				let strGet(kb.vectorK, i) -> before in
				if now<>before then (
					if 0<>now then _keyboardRepeat(kb, i, now, 500)
					else
					let _keyboardCode(kb, before) -> key in 
					if key<>nil then
					(
						if DEBUG then echoLn strFormat("keyUp *", key);
						uiPostKeyUp(key)
					)
				);
			set kb.vectorK=data
		);
		_keyboardLoop(ep, kb)
	);;

fun keyboardCreate(d, protocol, interfaceNumber, epDescriptors)=
	echoLn strFormat("> USB: start keyboard");
	if DEBUG then for epDescriptor in epDescriptors do hexDump epDescriptor;
	let epDescriptors -> hidDescriptor::epDescriptor::_ in
	let hidGetReport(d, interfaceNumber, hidDescriptor) -> report in
	if report==nil then return msgAndReturn("keyboard report failed", nil)
	else
	let hidEpStart(d, protocol, interfaceNumber, epDescriptor) -> ep in 
	if ep==nil then return msgAndReturn("keyboard endpoint failed", nil)
	else (
		_keyboardLoop(ep, [vectorK=strCreate(KEYBOARD_REPORT_SIZE, 0)]);
		true
	);;

fun _init()= usbRegister("int-3-1-1", #keyboardCreate);;
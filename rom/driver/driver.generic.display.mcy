const _FONT_H=8;;
const _FONT_W=6;;

fun drawChar(x, y, c, inverse)=
	let if inverse then 255 else 0 -> inverse in
	let if c<128 then _FONT_20_7f else _FONT_a0_ff -> font in
	let _FONT_W*((c&0x7f)-32) -> c in
	let uiBuffer() -> bmp in
	for i=0;i<_FONT_W do
		let inverse ^ strGet(font, c+i) -> mask in
		for j=0;j<_FONT_H do
			bitmapPlot(bmp, x+i, y+j, if bitTest(mask, 1<<j) then 0xffffff else 0, nil);;

fun drawString(x, y, str, inverse)=	// expect Latin encoding
	for i=0;i<strLength(str) do drawChar(x+i*_FONT_W, y, strGet(str, i), inverse);;

fun drawStringCenter(x, y, str, inverse)= drawString(x-(_FONT_W*strLength(str))>>1, y, str, inverse);;
fun drawStringRight(x, y, str, inverse)= drawString(x-_FONT_W*strLength(str), y, str, inverse);;

fun drawBitmap(x, y, src, w)=
	let (w+7)>>3 -> nextLine in
	let (nextLine-1+strLength(src))/nextLine -> h in
	let uiBuffer() -> bmp in
	for j=0;j<h do
		let j*nextLine -> index in
		for i=0;i<w do
			bitmapPlot(bmp, x+i, y+j, if bitTest(strGet(src, index+(i>>3)), 128>>(i&7)) then 0xffffff else 0, nil);;

#ifdef i2cInit
var _Bmp;;
var _W;;
var _H;;

var _FUpdate :(fun Bitmap -> Bool);;

var _SwitchDownCb;;
var _SwitchUpCb;;
var _GpioKeyList;;

fun displaySetup(width, height, fUpdate) =
	set _W=width; set _H=height;
	set _FUpdate=fUpdate;;

fun keyEmulateWithGpio(key, pin)=
	set _GpioKeyList=[key, pin]::_GpioKeyList;;

fun _keyStartEmulation(key:Int, pin)=
	gpioSetPulls(true, false, gpioSetDir(false, gpioInit(pin)));
	let watcherOpen(strFormat("pin*", pin)) -> watcher in
		let gpioWatcherAddress(pin) -> addr in
		let gpioWatcherMask(pin) -> mask in (
			watcherUpdate(watcher, addr, mask, mask);
			watcherOnEvent(watcher, lambda()= 
				let gpioGet(pin) -> state in (
					// watcher is fired when memory value gets different from value argument
					watcherUpdate(watcher, addr, mask, (if state then mask else 0));
					call if state then _SwitchUpCb else _SwitchDownCb(key)
				)
			)
		);;

fun screenW ()= _W;;
fun screenH ()= _H;;
fun uiW()= bitmapW(_Bmp);;
fun uiH()= bitmapH(_Bmp);;

fun uiBuffer ()= _Bmp;;
fun uiStart(x, y, w, h, flags, title) =
	set _Bmp=bitmapCreate(_W, _H, 0);

	for [key, pin] in _GpioKeyList do _keyStartEmulation(key, pin);
	set _GpioKeyList=nil;
	0;;

fun uiUpdate ()= call _FUpdate(_Bmp);;

fun uiOnKeyDown(cb) = set _SwitchDownCb = (lambda(key) = call cb(key); true);;
fun uiOnKeyUp(cb) = set _SwitchUpCb = (lambda(key) = call cb(key); true);;
#else
use bios as bios;;

fun keyEmulateWithGpio(key, pin)= nil;;
fun displaySetup (width, height, fUpdate) = nil;;

#ifdef glSwapBuffers
const _SCALE=8;;
#else
const _SCALE=1;;
#endif
fun uiStart( x, y, w, h, flags, title)=
	bios.uiStart( x, y, w*_SCALE, h*_SCALE, flags, title);
	uiBufferSetSize( w, h, false);; 
#endif

